# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- PostgreSQL -------------------------------------------------------------
# Full connection string, e.g. from Neon/Supabase/RDS/local Postgres.
# Replace each placeholder: USER, PASSWORD, SERVER, PORT, DB
DATABASE_URL=postgresql://USER:PASSWORD@SERVER:PORT/DB

# Set to "disable" only for a local/self-hosted Postgres with no TLS at all.
# Leave unset for hosted Postgres (Neon, Supabase, RDS, etc.).
# PGSSLMODE=disable

# --- NextAuth -----------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Base URL of this deployment. http://localhost:3000 in dev.
AUTH_URL=http://localhost:3000

# Optional — "Continue with Google". Leave blank to hide the Google button.
# Create credentials at https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
